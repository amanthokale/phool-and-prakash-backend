PORT=5000
# Frontend origin(s) allowed by CORS. Separate several with commas.
FRONTEND_URL=http://localhost:5173
# Public site address used in email links (defaults to the first FRONTEND_URL)
PUBLIC_SITE_URL=

PHOOL_PRAKASH_MONGODB_URI=

# Admin login. Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=
# Used only by `npm run seed:admin`. Remove the password after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email notifications (free): Gmail SMTP with an App Password
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RangPop <your-gmail@gmail.com>
# Where new-order alerts go (defaults to SMTP_USER)
ADMIN_NOTIFY_EMAIL=

# Product image uploads (free Cloudinary account: cloudinary.com > Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
